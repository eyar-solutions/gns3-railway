    "registry_version": 4,
    "status": "stable",
    "maintainer": "gns3-railway",
    "usage": "Use 'ovs-vsctl show' to inspect the switch. Add ports: 'ovs-vsctl add-port br0 eth1'. Set VLAN: 'ovs-vsctl set port eth1 tag=10'. Each adapter maps to eth{N}. Bridge 'br0' is created automatically.",
    "symbol": "ethernet_switch",
    "port_name_format": "eth{0}",
    "port_segment_size": 0,
